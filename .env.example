# Copy this file to .env.local (repo root) and fill in the values.
# .env.local is gitignored. Never commit real secrets, and never paste them into any chat.
# Comments sit above each variable, not after it, so a pasted value is never cut short by a '#'.

# Hardhat deployer key (same wallet as the authority). Used by pnpm deploy:testnet / verify:testnet.
PRIVATE_KEY=

# Authority key for ops scripts: createExam, registerCentres, recordLeak, revoke, reveal.
AUTHORITY_PRIVATE_KEY=

# 5 comma-separated custodian addresses, in Shamir piece order. 1-3 = BridgeKey (live), 4-5 = scripted.
CUSTODIAN_ADDRESSES=

# Key for scripted custodian 4 (pnpm ops release --custodian 4).
CUSTODIAN_4_PRIVATE_KEY=

# Key for scripted custodian 5 (pnpm ops release --custodian 5).
CUSTODIAN_5_PRIVATE_KEY=

# Fixed 32-byte hex seed so printed leak photos match every demo exam (secret, demo only).
DEMO_CODEBOOK_SEED=

# Blockscout verification. Not a secret: any non-empty string works when no key is issued.
MSTSCAN_API_KEY=placeholder

# Anthropic API key for /api/extract when EXTRACTOR_PROVIDER=claude (server only; also set in Vercel).
ANTHROPIC_API_KEY=

# Gemini API key for /api/extract when EXTRACTOR_PROVIDER=gemini (server only; also set in Vercel).
GEMINI_API_KEY=

# Which vision extractor /api/extract uses: gemini | claude | manual. Not a secret.
EXTRACTOR_PROVIDER=gemini

# Optional: enables WalletConnect in the frontend. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
